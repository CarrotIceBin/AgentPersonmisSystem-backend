{
  "name": "Personmis backend",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 java -jar target/personmis-0.0.1-SNAPSHOT.jar"
    },
    {
      "name": "agent",
      "command": "python3 -m uvicorn agent_server:app --host 0.0.0.0 --port 8000"
    }
  ],
  "ports": [8443, 8000]
}
